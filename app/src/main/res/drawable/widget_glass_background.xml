<?xml version="1.0" encoding="utf-8"?>
<!-- Dark translucent glass: widgets cannot blur the wallpaper, so the tint must stay dark enough
     for white text (55-70% black keeps >= 4.5:1 even over a white wallpaper). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <corners android:radius="24dp" />
    <gradient
        android:angle="135"
        android:endColor="#8C000000"
        android:startColor="#B3000000" />
    <stroke
        android:width="1dp"
        android:color="#59FFFFFF" />
</shape>
